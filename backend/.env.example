# Local development only. Put real values in ignored .env or hosting secret settings.
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/callback
COOKIE_SECURE=false
# Optional locally; mandatory on Vercel. Use the Neon-provided TLS connection URL.
DATABASE_URL=
# Mandatory when DATABASE_URL is set. Generate privately; keep the same key across deployments.
TOKEN_ENCRYPTION_KEY=
# Optional: actual Google Web OAuth client JSON. Alternatively use credentials.json.
GOOGLE_CREDENTIALS_JSON=
